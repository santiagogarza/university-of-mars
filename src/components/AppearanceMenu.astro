---
import { TEXT_SCALE_MAX, TEXT_SCALE_MIN, TEXT_SCALE_STEP } from '../lib/appearance';

const themes = [
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
  { value: 'system', label: 'System' },
] as const;
---

<div class="appearance" data-appearance>
  <button
    class="appearance-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="appearance-panel"
    data-appearance-toggle
  >
    <svg class="appearance-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
    </svg>
    <span class="appearance-toggle-label">Display</span>
  </button>

  <div
    class="appearance-panel"
    id="appearance-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="appearance-title"
    aria-describedby="appearance-note"
    hidden
    data-appearance-panel
  >
    <div class="appearance-head">
      <p class="appearance-title" id="appearance-title">Display settings</p>
      <p class="appearance-note" id="appearance-note">Saved in this browser. Applies to every page.</p>
    </div>

    <fieldset class="appearance-group">
      <legend class="appearance-label">Theme</legend>
      <div class="theme-options">
        {
          themes.map((theme) => (
            <label class="theme-option">
              <input type="radio" name="um-theme" value={theme.value} data-appearance-theme />
              <span class="theme-option-face">
                {theme.value === 'light' && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="4.2" fill="currentColor" />
                    <path
                      d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                    />
                  </svg>
                )}
                {theme.value === 'dark' && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M19.5 14.6A7.9 7.9 0 0 1 9.4 4.5a7.9 7.9 0 1 0 10.1 10.1z" fill="currentColor" />
                  </svg>
                )}
                {theme.value === 'system' && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <rect x="3" y="4.5" width="18" height="12" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <path d="M12 4.5a6 6 0 0 1 0 12z" fill="currentColor" />
                    <path d="M8.5 20h7M12 16.5V20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  </svg>
                )}
                <span>{theme.label}</span>
              </span>
            </label>
          ))
        }
      </div>
      <p class="appearance-hint" data-appearance-system-hint>System follows your device: <span data-appearance-system-mode>light</span> right now.</p>
    </fieldset>

    <div class="appearance-group">
      <div class="appearance-row">
        <label class="appearance-label" for="appearance-text-size">Text size</label>
        <output class="text-size-value" for="appearance-text-size" data-appearance-scale-value>100%</output>
      </div>
      <div class="text-size-control">
        <span class="text-size-glyph text-size-glyph-small" aria-hidden="true">A</span>
        <input
          id="appearance-text-size"
          class="text-size-range"
          type="range"
          min={TEXT_SCALE_MIN}
          max={TEXT_SCALE_MAX}
          step={TEXT_SCALE_STEP}
          value="100"
          aria-describedby="appearance-text-size-hint"
          data-appearance-scale
        />
        <span class="text-size-glyph text-size-glyph-large" aria-hidden="true">A</span>
      </div>
      <p class="appearance-hint" id="appearance-text-size-hint">{TEXT_SCALE_MIN}% to {TEXT_SCALE_MAX}% of your browser’s text size.</p>
    </div>

    <div class="appearance-group appearance-switches">
      <label class="switch">
        <input type="checkbox" role="switch" aria-describedby="appearance-dyslexic-hint" data-appearance-dyslexic />
        <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
        <span class="switch-text">
          <span class="switch-label">Dyslexia-friendly font</span>
          <span class="appearance-hint" id="appearance-dyslexic-hint">OpenDyslexic, with wider letter and line spacing.</span>
        </span>
      </label>
      <label class="switch">
        <input type="checkbox" role="switch" aria-describedby="appearance-motion-hint" data-appearance-motion />
        <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
        <span class="switch-text">
          <span class="switch-label">Reduce motion</span>
          <span class="appearance-hint" id="appearance-motion-hint">Turns off animation and smooth scrolling. Starts from your device setting.</span>
        </span>
      </label>
    </div>

    <div class="appearance-foot">
      <button class="linkish" type="button" data-appearance-reset>Reset to defaults</button>
      <button class="btn btn-navy appearance-done" type="button" data-appearance-done>Done</button>
    </div>
    <p class="sr-only" aria-live="polite" data-appearance-status></p>
  </div>
</div>
