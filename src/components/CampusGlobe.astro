---
import { campuses } from '../data/campuses';
import { u } from '../lib/paths';

const fmtLat = (lat: number) => `${Math.abs(lat).toFixed(2)}° ${lat >= 0 ? 'N' : 'S'}`;
const fmtLon = (lon: number) => `${Math.abs(lon).toFixed(2)}° ${lon >= 0 ? 'E' : 'W'}`;
const mapLeft = (lon: number) => `${(((lon + 180) / 360) * 100).toFixed(2)}%`;
const mapTop = (lat: number) => `${(((90 - lat) / 180) * 100).toFixed(2)}%`;
---

<section class="campus-section" id="campuses" aria-labelledby="campuses-title">
  <div class="wrap">
    <div class="campus-intro">
      <p class="eyebrow">Jezero and the field stations</p>
      <h2 id="campuses-title">Our campuses</h2>
      <p class="lede">
        Classes meet on the Jezero campus. Three field stations put students on a volcano summit, a canyon floor, and an
        old lakebed. Turn the planet to find them, or pick a site below.
      </p>
    </div>

    <div class="campus-explorer" data-campus-globe data-mode="pending">
      <div class="globe-stage" data-globe-stage aria-describedby="globe-keys">
        <div class="globe-canvas" data-globe-canvas></div>

        <div class="globe-map" data-globe-map>
          <img
            src={u('/textures/mars-map.webp')}
            width="1600"
            height="800"
            loading="lazy"
            decoding="async"
            alt="Flat map of Mars marking the Jezero campus and the Olympus Mons, Valles Marineris, and Gale Crater field stations."
          />
          {
            campuses.map((campus) => (
              <a
                class:list={['map-pin', { 'is-main': campus.kind === 'Main campus' }]}
                href={`#campus-${campus.id}`}
                data-campus-select={campus.id}
                style={`left: ${mapLeft(campus.lon)}; top: ${mapTop(campus.lat)};`}
              >
                <span class="map-pin-dot" aria-hidden="true" />
                <span class="map-pin-label">{campus.short}</span>
              </a>
            ))
          }
        </div>

        <div class="globe-hud" aria-hidden="true">
          <span><b>MTC</b> <span data-hud-mtc>--:--</span></span>
          <span><b>Sol</b> <span data-hud-sol>—</span></span>
          <span><b>MY</b> <span data-hud-year>—</span></span>
          <span><b>Ls</b> <span data-hud-ls>—</span></span>
        </div>

        <p class="globe-status" data-globe-status role="status"></p>
        <button class="globe-optin" type="button" data-globe-optin hidden>Show the 3D globe</button>

        <div class="globe-tools">
          <button type="button" data-globe-zoom-in aria-label="Zoom in">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" /></svg>
          </button>
          <button type="button" data-globe-zoom-out aria-label="Zoom out">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12" /></svg>
          </button>
          <button type="button" data-globe-reset aria-label="Reset the view">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 9.5a5.5 5.5 0 1 1 1.7 4M4.5 14.5v-5h5" /></svg>
          </button>
        </div>
      </div>

      <div class="campus-cards" data-campus-cards>
        {
          campuses.map((campus) => (
            <article class="campus-card" id={`campus-${campus.id}`} data-campus-card={campus.id} aria-labelledby={`campus-${campus.id}-title`}>
              <header class="campus-card-head">
                <p class="kicker">
                  {campus.kind} · Founded {campus.founded}
                </p>
                <h3 id={`campus-${campus.id}-title`}>{campus.name}</h3>
                <button class="campus-close" type="button" data-campus-close aria-label={`Close ${campus.name} details`}>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
                </button>
              </header>
              <p class="campus-summary">{campus.summary}</p>
              <dl class="campus-facts">
                <div>
                  <dt>Founded</dt>
                  <dd>{campus.founded}</dd>
                </div>
                <div>
                  <dt>Elevation</dt>
                  <dd>{campus.elevation}</dd>
                </div>
                <div>
                  <dt>Location</dt>
                  <dd>
                    {fmtLat(campus.lat)}, {fmtLon(campus.lon)}
                  </dd>
                </div>
              </dl>
              <div class="campus-now">
                <p class="campus-now-label">Local mean solar time</p>
                <p class="campus-clock">
                  <span data-clock>--:--:--</span>
                </p>
                <p class="campus-now-sub">
                  <span data-daypart>—</span> · Sol <span data-sol>—</span> · <span data-season>—</span>
                </p>
                <dl class="campus-weather">
                  <div>
                    <dt>Air now</dt>
                    <dd data-w-now>—</dd>
                  </div>
                  <div>
                    <dt>High / low</dt>
                    <dd data-w-range>—</dd>
                  </div>
                  <div>
                    <dt>Pressure</dt>
                    <dd data-w-pressure>—</dd>
                  </div>
                  <div>
                    <dt>Wind</dt>
                    <dd data-w-wind>—</dd>
                  </div>
                  <div class="wide">
                    <dt>Sky</dt>
                    <dd data-w-sky>—</dd>
                  </div>
                </dl>
              </div>
              <h4>Programs</h4>
              <ul class="campus-programs">
                {campus.programs.map((program) => <li>{program}</li>)}
              </ul>
            </article>
          ))
        }
      </div>

      <ul class="campus-list" aria-label="Campus sites">
        {
          campuses.map((campus) => (
            <li>
              <a class:list={['campus-chip', { 'is-main': campus.kind === 'Main campus' }]} href={`#campus-${campus.id}`} data-campus-select={campus.id}>
                <span class="campus-chip-dot" aria-hidden="true" />
                <span class="campus-chip-name">{campus.name}</span>
                <span class="campus-chip-kind">{campus.kind}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="globe-keys" id="globe-keys">
        Drag to turn the planet and scroll to zoom. With the globe focused, use the left and right arrow keys to visit each
        site, plus and minus to zoom, Escape to close the details, and Home to reset the view. Station clocks run on
        the campus day; the weather readouts are illustrative sample data, not a live feed.
      </p>
      <div class="sr-only" aria-live="polite" data-globe-live></div>
    </div>
  </div>
</section>

<script>
  import '../scripts/campus-globe.ts';
</script>

<style is:global>
  .campus-section {
    --space-ink: #070c15;
    --glow-main: #ffd27a;
    --glow-station: #9fe6ff;
    --on-dark: #efe7dc;
    --on-dark-soft: #cfc4b6;
    background:
      radial-gradient(120% 80% at 85% 0%, rgba(36, 72, 106, 0.75), rgba(36, 72, 106, 0) 60%),
      linear-gradient(180deg, #14263c 0%, #0c1726 100%);
    color: var(--on-dark);
    padding: var(--space-xl) 0;
  }

  .campus-section h2 {
    color: var(--white);
  }

  .campus-section .eyebrow {
    color: #e3bd8c;
  }

  .campus-section .lede {
    color: var(--on-dark-soft);
  }

  .campus-section :focus-visible {
    outline-color: var(--focus-ring-on-dark);
  }

  .campus-intro {
    margin-bottom: var(--space-md);
  }

  .campus-explorer {
    --stage-h: clamp(480px, 76vh, 680px);
    position: relative;
  }

  .globe-stage {
    position: relative;
    height: var(--stage-h);
    overflow: hidden;
    border: 1px solid rgba(166, 133, 86, 0.45);
    background:
      radial-gradient(60% 70% at 42% 50%, rgba(36, 72, 106, 0.45), rgba(7, 12, 21, 0) 70%),
      var(--space-ink);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }

  .globe-stage:focus-visible {
    outline: 3px solid var(--white);
    outline-offset: 3px;
  }

  .globe-canvas,
  .globe-gl,
  .globe-labels {
    position: absolute;
    inset: 0;
  }

  .globe-gl {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .globe-gl:active {
    cursor: grabbing;
  }

  [data-mode='3d'] .globe-gl {
    opacity: 1;
  }

  .globe-labels {
    pointer-events: none;
  }

  .globe-label {
    position: absolute;
    left: 0;
    top: 0;
    translate: 16px -50%;
    padding: 0.15rem 0.55rem 0.2rem;
    border: 1px solid rgba(159, 230, 255, 0.55);
    border-radius: 999px;
    background: rgba(7, 12, 21, 0.72);
    color: var(--white);
    font: 700 0.74rem/1.3 var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .globe-label.is-main {
    border-color: rgba(255, 210, 122, 0.7);
  }

  .globe-label:hover,
  .globe-label.is-active {
    background: var(--oxblood);
    border-color: var(--glow-main);
  }

  .globe-map {
    display: none;
    position: relative;
  }

  .globe-map img {
    display: block;
    width: 100%;
    height: auto;
  }

  .campus-explorer:not(.is-enhanced) .globe-map,
  [data-mode='map'] .globe-map {
    display: block;
  }

  .campus-explorer:not(.is-enhanced) .globe-stage,
  [data-mode='map'] .globe-stage {
    height: auto;
  }

  .campus-explorer:not(.is-enhanced) .globe-canvas,
  .campus-explorer:not(.is-enhanced) .globe-tools,
  [data-mode='map'] .globe-canvas,
  [data-mode='map'] .globe-tools,
  [data-mode='pending'] .globe-tools,
  [data-mode='loading'] .globe-tools {
    display: none;
  }

  .map-pin {
    position: absolute;
    translate: -9px -9px;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--white);
    text-decoration: none;
    font: 700 0.78rem/1.2 var(--sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .map-pin-dot {
    width: 18px;
    height: 18px;
    flex: none;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0 25%, var(--glow-station) 45%, rgba(159, 230, 255, 0) 72%);
    box-shadow: 0 0 14px rgba(159, 230, 255, 0.8);
  }

  .map-pin.is-main .map-pin-dot {
    background: radial-gradient(circle, #fff 0 25%, var(--glow-main) 45%, rgba(255, 210, 122, 0) 72%);
    box-shadow: 0 0 16px rgba(255, 210, 122, 0.9);
  }

  .map-pin-label {
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: rgba(7, 12, 21, 0.78);
  }

  .map-pin:hover .map-pin-label,
  .map-pin[aria-current='true'] .map-pin-label {
    background: var(--oxblood);
    color: var(--white);
  }

  .globe-hud {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    max-width: calc(100% - 1.6rem);
    padding: 0.3rem 0.65rem;
    background: rgba(7, 12, 21, 0.72);
    color: var(--on-dark-soft);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  .globe-hud b {
    color: #e3bd8c;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-right: 0.2rem;
  }

  .globe-status {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    margin: 0;
    color: var(--on-dark-soft);
    font-size: 0.95rem;
    text-align: center;
    pointer-events: none;
  }

  .globe-status:empty {
    display: none;
  }

  [data-mode='map'] .globe-status {
    position: static;
    translate: none;
    padding: 0.7rem 1rem;
    border-top: 1px solid rgba(166, 133, 86, 0.35);
    text-align: left;
  }

  .globe-optin {
    position: absolute;
    top: 0.7rem;
    right: 0.8rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.9rem;
    border: 2px solid var(--on-dark);
    border-radius: 2px;
    background: rgba(7, 12, 21, 0.75);
    color: var(--white);
    font: 700 0.92rem/1.2 var(--sans);
    cursor: pointer;
  }

  .globe-optin:hover {
    background: var(--white);
    color: var(--navy);
  }

  .globe-tools {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: flex;
    gap: 0.4rem;
  }

  .globe-tools button,
  .campus-close {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid rgba(239, 231, 220, 0.45);
    border-radius: 2px;
    background: rgba(7, 12, 21, 0.7);
    color: var(--white);
    cursor: pointer;
  }

  .globe-tools button:hover {
    background: var(--oxblood);
    border-color: var(--oxblood);
  }

  .globe-tools svg,
  .campus-close svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .campus-cards {
    margin-top: var(--space-sm);
  }

  .campus-explorer:not(.is-enhanced) .campus-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
  }

  .campus-card {
    background: var(--paper);
    color: var(--ink);
    border-top: 4px solid var(--oxblood);
    padding: 0.95rem 1.15rem 0.9rem;
    line-height: 1.45;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.4);
  }

  .campus-card-head {
    position: relative;
    padding-right: 2.8rem;
  }

  .campus-card h3 {
    margin: 0.15rem 0 0.4rem;
    font-size: 1.4rem;
  }

  .campus-card h4 {
    margin: 0.75rem 0 0.3rem;
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy);
  }

  .campus-close {
    position: absolute;
    top: -0.2rem;
    right: -0.3rem;
    background: transparent;
    border-color: var(--line);
    color: var(--ink);
  }

  .campus-close:hover {
    background: var(--oxblood);
    border-color: var(--oxblood);
    color: var(--white);
  }

  .campus-card :focus-visible {
    outline-color: var(--focus-ring);
  }

  .campus-summary {
    margin-bottom: 0.6rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .campus-facts,
  .campus-weather {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem 1rem;
    margin: 0;
  }

  .campus-facts {
    grid-template-columns: auto auto 1fr;
    padding: 0.5rem 0;
    border-block: 1px solid var(--line);
  }

  .campus-facts dt,
  .campus-weather dt {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .campus-facts dd,
  .campus-weather dd {
    margin: 0;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  .campus-now {
    margin-top: 0.75rem;
    padding: 0.7rem 0.95rem 0.8rem;
    background: var(--navy);
    color: var(--sand);
  }

  .campus-now p {
    margin: 0;
  }

  .campus-now-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #e3bd8c;
  }

  .campus-clock {
    font-family: var(--serif);
    font-size: 2.1rem;
    line-height: 1.05;
    color: var(--white);
    font-variant-numeric: tabular-nums;
  }

  .campus-now-sub {
    font-size: 0.9rem;
    color: var(--on-dark-soft);
    margin-bottom: 0.55rem !important;
  }

  .campus-weather {
    padding-top: 0.55rem;
    border-top: 1px solid rgba(239, 231, 220, 0.2);
  }

  .campus-weather .wide {
    grid-column: 1 / -1;
  }

  .campus-weather dt {
    color: var(--on-dark-soft);
  }

  .campus-weather dd {
    color: var(--white);
  }

  .campus-programs {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.93rem;
  }

  .campus-programs li + li {
    margin-top: 0.1rem;
  }

  .campus-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
  }

  .campus-chip {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.6rem;
    align-items: center;
    height: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid rgba(239, 231, 220, 0.25);
    background: rgba(7, 12, 21, 0.45);
    color: var(--white);
    text-decoration: none;
  }

  .campus-chip:hover {
    border-color: #e3bd8c;
    color: var(--white);
  }

  .campus-chip[aria-current='true'] {
    border-color: var(--glow-main);
    background: var(--oxblood);
  }

  .campus-chip-dot {
    grid-row: span 2;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--glow-station);
    box-shadow: 0 0 10px var(--glow-station);
  }

  .campus-chip.is-main .campus-chip-dot {
    background: var(--glow-main);
    box-shadow: 0 0 10px var(--glow-main);
  }

  .campus-chip-name {
    font-weight: 700;
    line-height: 1.25;
  }

  .campus-chip-kind {
    font-size: 0.82rem;
    color: var(--on-dark-soft);
  }

  .campus-chip[aria-current='true'] .campus-chip-kind {
    color: var(--sand);
  }

  .globe-keys {
    margin: var(--space-sm) 0 0;
    max-width: var(--measure);
    font-size: 0.9rem;
    color: var(--on-dark-soft);
  }

  @media (min-width: 900px) {
    [data-mode='3d'] .campus-cards,
    [data-mode='loading'] .campus-cards,
    [data-mode='pending'] .campus-cards {
      position: absolute;
      top: 1rem;
      right: 1rem;
      width: min(360px, 40%);
      max-height: calc(var(--stage-h) - 2rem);
      margin: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      animation: campus-card-in 0.35s ease both;
    }
  }

  @keyframes campus-card-in {
    from {
      opacity: 0;
      translate: 16px 0;
    }
  }

  @media (max-width: 899px) {
    .campus-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .campus-explorer {
      --stage-h: 420px;
    }

    .campus-explorer:not(.is-enhanced) .campus-cards {
      grid-template-columns: 1fr;
    }

    .map-pin-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .globe-hud {
      font-size: 0.72rem;
    }
  }
</style>
