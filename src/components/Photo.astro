---
import { u } from '../lib/paths';

interface Props {
  name: string;
  alt: string;
  sizes?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  width?: number;
  height?: number;
}

const {
  name,
  alt,
  sizes = '(min-width: 900px) 40rem, 100vw',
  class: className,
  loading = 'lazy',
  width = 1280,
  height = 720,
} = Astro.props;

const widths = [640, 960, 1280];
const srcset = widths.map((w) => `${u(`/images/${name}-${w}.webp`)} ${w}w`).join(', ');
---

<picture class={className}>
  <source type="image/webp" srcset={srcset} sizes={sizes} />
  <img
    src={u(`/images/${name}.jpg`)}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
  />
</picture>
