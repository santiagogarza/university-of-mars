---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
import { u } from '../lib/paths';

const widths = [640, 960, 1280];
const heroSrcset = widths.map((w) => `${u(`/images/hero-quad-${w}.webp`)} ${w}w`).join(', ');
---

<Base
  title="University of Mars"
  description="The University of Mars is a public research university on the Jezero campus. Spring Semester 2027 is in session."
>
  <section class="hero">
    <picture class="hero-picture">
      <source type="image/webp" srcset={heroSrcset} sizes="100vw" />
      <img
        class="hero-media"
        src={u('/images/hero-quad.jpg')}
        width="1280"
        height="720"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero-copy">
        <p class="eyebrow">Jezero campus</p>
        <h1>The public research university of Jezero.</h1>
        <p class="hero-deck">
          Spring Semester 2027 is in session. Eight colleges share one residential campus, from the main quad to the observatory.
        </p>
        <p class="hero-actions">
          <a class="btn" href={u('/admissions/')}>Apply for Fall 2027</a>
          <a class="text-link" href={u('/academics/calendar/')}>Academic calendar</a>
        </p>
      </div>
    </div>
  </section>

  <section class="stats" aria-label="University figures">
    <div class="wrap stats-grid">
      <p><strong>28,400</strong><span>students in 2026–27</span></p>
      <p><strong>8</strong><span>colleges and schools</span></p>
      <p><strong>{site.founded}</strong><span>year chartered</span></p>
      <p><strong>94%</strong><span>of first-years live on campus</span></p>
    </div>
  </section>

  <section class="section" id="news">
    <div class="wrap">
      <div class="section-head">
        <h2>Campus news</h2>
      </div>
      <div class="news-grid">
        <article class="news-card">
          <div class="frame">
            <Photo
              name="library"
              alt="Glass atrium of the University Library at dusk, with wide steps and red hills behind it."
              sizes="(min-width: 900px) 340px, 100vw"
            />
          </div>
          <div class="news-card-body">
            <p class="news-meta">January 4, 2027 · Library</p>
            <h3><a href={u('/news/library-hours/')}>Reading rooms return to a midnight close</a></h3>
            <p>Fall finals late hours have ended. Spring Semester rooms close at midnight on class days.</p>
          </div>
        </article>
        <article class="news-card">
          <div class="frame">
            <Photo
              name="research"
              alt="Research building with a rooftop observatory dome at blue hour, beside a red plain."
              sizes="(min-width: 900px) 340px, 100vw"
            />
          </div>
          <div class="news-card-body">
            <p class="news-meta">October 14, 2026 · Research</p>
            <h3><a href={u('/news/fellowships/')}>Summer research fellowships are open</a></h3>
            <p>Undergraduates in every college may apply for Summer Session 2027. The deadline is February 1.</p>
          </div>
        </article>
        <article class="news-card">
          <div class="frame">
            <Photo
              name="students"
              alt="Students studying with laptops at an outdoor table, seen mostly from behind."
              sizes="(min-width: 900px) 340px, 100vw"
            />
          </div>
          <div class="news-card-body">
            <p class="news-meta">October 2, 2026 · Financial aid</p>
            <h3><a href={u('/news/scholars/')}>Red Planet Scholars named for 2026–27</a></h3>
            <p>The award sits inside this year’s grant package. Continuing students do not file a separate essay.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap split">
      <div>
        <div class="section-head">
          <h2>On the calendar</h2>
          <a href={u('/academics/calendar/')}>Full calendar</a>
        </div>
        <ol class="event-list">
          <li>
            <p class="event-date"><b>15</b><span>Jan</span></p>
            <div>
              <h3>Spring Semester 2027 add/drop deadline</h3>
              <p>Friday, January 15, 2027. Last day to add or drop without a petition.</p>
            </div>
          </li>
          <li>
            <p class="event-date"><b>15</b><span>Feb</span></p>
            <div>
              <h3>Presidents Day</h3>
              <p>Monday, February 15, 2027. Campus closed.</p>
            </div>
          </li>
          <li>
            <p class="event-date"><b>22</b><span>Mar</span></p>
            <div>
              <h3>Spring recess</h3>
              <p>Monday, March 22 through Friday, March 26, 2027. Classes do not meet.</p>
            </div>
          </li>
          <li>
            <p class="event-date"><b>30</b><span>Apr</span></p>
            <div>
              <h3>Last day of instruction</h3>
              <p>Friday, April 30, 2027. Spring Semester classes end.</p>
            </div>
          </li>
          <li>
            <p class="event-date"><b>3</b><span>May</span></p>
            <div>
              <h3>Spring final examinations</h3>
              <p>Monday, May 3 through Friday, May 7, 2027.</p>
            </div>
          </li>
          <li>
            <p class="event-date"><b>15</b><span>May</span></p>
            <div>
              <h3>Commencement</h3>
              <p>Saturday, May 15, 2027, on the main quad.</p>
            </div>
          </li>
        </ol>
      </div>
      <div>
        <div class="section-head">
          <h2>Most requested</h2>
        </div>
        <div class="tiles">
          <a class="tile" href={u('/support/')}><strong>Help Center</strong><span>Articles, requests, and office hours.</span></a>
          <a class="tile" href={u('/financial-aid/')}><strong>Financial aid</strong><span>Aid year 2026–27, holds, and documents.</span></a>
          <a class="tile" href={u('/housing/')}><strong>Housing</strong><span>Halls, spring move-in, and repairs.</span></a>
          <a class="tile" href={u('/academics/calendar/')}><strong>Academic calendar</strong><span>Fall 2026 and Spring 2027 dates.</span></a>
          <a class="tile" href={u('/support/articles/billing/')}><strong>Pay a bill</strong><span>Charges, refunds, and payment plans.</span></a>
          <a class="tile" href={u('/news/library-hours/')}><strong>Library hours</strong><span>Midnight close on class days this spring.</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>
