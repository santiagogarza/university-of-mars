---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---

<Base title="Library hours" description="Spring Semester 2027 reading rooms close at midnight on class days.">
  <PageHero
    eyebrow="January 4, 2027"
    title="Reading rooms return to a midnight close"
    lede="Fall Semester late hours ended Friday, December 11, 2026. During Spring Semester 2027 the main library reading rooms close at midnight."
    crumbs={[
      { href: '/#news', label: 'News' },
      { href: '/news/library-hours/', label: 'Library hours' },
    ]}
  />
  <article class="prose wrap narrow">
    <p>
      The first-floor reading room stays open until midnight on class days. Stacks above the second floor close at the
      same time. College of Science teaching labs are not part of this schedule. The 2 a.m. close returns for the end of
      the spring term, Monday, April 26 through Friday, May 7.
    </p>
    <p>
      A campus card is required after 10 p.m. Food is limited to covered drinks outside the special-collections room.
      The late bus from the library loop to Syrtis Court and Elysium Hall runs until 12:15 a.m., and until 2:15 a.m.
      during spring finals.
    </p>
  </article>
</Base>
