---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { site } from '../../data/site';
import { u } from '../../lib/paths';
---

<Base
  title="Student Support"
  description="Search help articles or submit a request to financial aid, housing, registration, billing, IT, or accessibility."
>
  <PageHero
    eyebrow="Help Center"
    title="Student Support"
    lede="Find an answer by topic, or send a request to the office that owns it. Most replies go out within one business day."
    crumbs={[{ href: '/support/', label: 'Student Support' }]}
  >
    <p class="page-actions">
      <a class="btn" href="#request">Submit a request</a>
    </p>
    <form class="portal-search" action={u('/search/')} method="get" role="search">
      <div class="search-field">
        <label for="support-search">Search help articles</label>
        <input id="support-search" name="q" type="search" placeholder="Try “aid hold”, “repair”, or “add a class”" />
      </div>
      <button class="btn btn-navy" type="submit">Search</button>
    </form>
  </PageHero>

  <div class="wrap support-layout">
    <section aria-labelledby="topics-heading">
      <h2 id="topics-heading">Topics</h2>
      <div class="category-grid">
        <a class="category" href={u('/financial-aid/')}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="18" height="12" rx="2"></rect><path d="M3 10h18"></path></svg>
          <span><strong>Financial Aid</strong><span>Awards, documents, and holds for 2026–27.</span></span>
        </a>
        <a class="category" href={u('/housing/')}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 11.5 12 4l8 7.5V20H4v-8.5z"></path><path d="M10 20v-6h4v6"></path></svg>
          <span><strong>Housing &amp; Residential Life</strong><span>Halls, move-in, and room repairs.</span></span>
        </a>
        <a class="category" href={u('/support/articles/registration/')}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3.5" width="16" height="17" rx="1.5"></rect><path d="M8 8h8M8 12h8M8 16h5"></path></svg>
          <span><strong>Registration &amp; Records</strong><span>Adds, drops, transcripts, and enrollment.</span></span>
        </a>
        <a class="category" href={u('/support/articles/password/')}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="10" width="14" height="10" rx="1.5"></rect><path d="M8 10V7.5a4 4 0 0 1 8 0V10"></path></svg>
          <span><strong>IT &amp; Accounts</strong><span>MyUM, email, password, and Wi-Fi.</span></span>
        </a>
        <a class="category" href={u('/support/articles/billing/')}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 4h12v16l-2-1.2L14 20l-2-1.2L10 20l-2-1.2L6 20V4z"></path><path d="M9 9h6M9 13h6"></path></svg>
          <span><strong>Billing</strong><span>Charges, payments, refunds, and plans.</span></span>
        </a>
        <a class="category" href={u('/accessibility/')}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="5" r="1.6"></circle><path d="M5 9.5h14M12 9.5V20M12 13l-4 3M12 13l4 3"></path></svg>
          <span><strong>Accessibility</strong><span>Accommodations and barrier reports.</span></span>
        </a>
      </div>
    </section>

    <section aria-labelledby="popular-heading">
      <div class="section-head">
        <h2 id="popular-heading">Popular articles</h2>
        <a href={u('/support/requests/')}>My requests</a>
      </div>
      <ul class="results">
        <li><a href={u('/support/articles/financial-aid-hold/')}>Clear a financial aid hold</a></li>
        <li><a href={u('/support/articles/housing-repair/')}>Request a housing repair</a></li>
        <li><a href={u('/support/articles/registration/')}>Add and drop in Spring Semester 2027</a></li>
        <li><a href={u('/support/articles/password/')}>Reset a UM password</a></li>
        <li><a href={u('/support/articles/billing/')}>Read a billing statement</a></li>
        <li><a href={u('/support/articles/accommodations/')}>Request a disability accommodation</a></li>
      </ul>
    </section>

    <section class="faq" id="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Registration FAQ</h2>
      <details open>
        <summary>When is the Spring Semester 2027 add/drop deadline?</summary>
        <p>
          The Spring Semester 2027 add/drop deadline is Friday, January 15, 2027. Until that day you may add or drop in
          MyUM without a petition and without a transcript notation. A drop after the deadline is a withdrawal and needs
          the college advisor’s approval.
        </p>
      </details>
      <details>
        <summary>Where do I send a missing financial aid document?</summary>
        <p>
          Follow the instructions on the Financial Aid page, then submit the packet from this Help Center with the
          category Financial aid hold. The aid counter in Enrollment Services, 140 Olympus Way, is open weekdays from
          9 a.m. to 4 p.m.
        </p>
      </details>
      <details>
        <summary>Who do I call for a residence-hall emergency?</summary>
        <p>
          For an active leak, a unit without heat, a full power loss, or a door that will not lock, call
          <a href={site.repairHref}>{site.repairPhone}</a>. Use the request form for everything else.
        </p>
      </details>
      <details>
        <summary>How do I reset MyUM?</summary>
        <p>
          Use the password article if you still have the inbox for your UM email. If you cannot get in at all, submit a
          request under IT &amp; Accounts and include a phone number.
        </p>
      </details>
    </section>

    <section id="request" aria-labelledby="request-heading">
      <div class="form-card" id="form-panel">
        <h2 id="request-heading" tabindex="-1">Submit a request</h2>
        <p>
          Use this form for aid holds, housing repairs, registration, billing, accounts, and access barriers. For
          immediate danger, call campus safety at <a href={site.safetyHref}>{site.safetyPhone}</a>.
        </p>
        <noscript>
          <p>Turn on scripts in this browser to submit a request and keep the ticket number under My requests.</p>
        </noscript>
        <div id="form-errors" class="error-summary" tabindex="-1" hidden></div>
        <form id="request-form" novalidate>
          <p class="required-note"><span class="req" aria-hidden="true">*</span> Required</p>
          <div class="form-grid">
            <div class="field">
              <label for="category">Category</label>
              <select id="category" name="category" required aria-required="true">
                <option value="">Select a category</option>
                <option value="financial-aid">Financial aid</option>
                <option value="financial-aid-hold">Financial aid hold</option>
                <option value="housing">Housing &amp; residential life</option>
                <option value="housing-repair">Housing repair</option>
                <option value="registration">Registration &amp; records</option>
                <option value="it">IT &amp; accounts</option>
                <option value="billing">Billing</option>
                <option value="accessibility">Accessibility</option>
                <option value="other">Something else</option>
              </select>
              <p class="field-error" id="category-error" hidden></p>
            </div>
            <div class="field">
              <label for="subcategory">Subcategory</label>
              <select id="subcategory" name="subcategory" required aria-required="true">
                <option value="">Select a subcategory</option>
              </select>
              <p class="field-error" id="subcategory-error" hidden></p>
            </div>
            <div class="field">
              <span class="req req-unlabeled" aria-hidden="true">*</span>
              <input
                id="student-id"
                name="studentId"
                type="text"
                inputmode="numeric"
                maxlength="9"
                placeholder="Student ID"
                autocomplete="off"
                spellcheck="false"
                required
                aria-required="true"
              />
              <p class="field-error" id="student-id-error" hidden></p>
            </div>
            <div class="field">
              <label for="email">UM email</label>
              <input id="email" name="email" type="email" autocomplete="email" placeholder="name@umars.edu" required aria-required="true" />
              <p class="field-error" id="email-error" hidden></p>
            </div>
            <div class="field full">
              <label for="subject">Subject</label>
              <input id="subject" name="subject" type="text" autocomplete="off" required aria-required="true" />
              <p class="field-error" id="subject-error" hidden></p>
            </div>
            <div class="field full">
              <label for="description">Description</label>
              <textarea id="description" name="description" rows="6" required aria-required="true"></textarea>
              <p class="field-error" id="description-error" hidden></p>
            </div>
            <div class="field full">
              <label for="attachment">Attachment <span class="hint">(optional)</span></label>
              <input id="attachment" name="attachment" type="file" accept=".pdf,.png,.jpg,.jpeg,.webp,application/pdf,image/png,image/jpeg,image/webp" />
              <p class="hint">PDF, PNG, or JPG. 5 MB or smaller.</p>
              <p class="field-error" id="attachment-error" hidden></p>
            </div>
            <fieldset class="field full choices">
              <legend>Priority</legend>
              <label><input type="radio" name="priority" value="Low" required aria-required="true" /> Low</label>
              <label><input id="priority-normal" type="radio" name="priority" value="Normal" checked required aria-required="true" /> Normal</label>
              <label><input type="radio" name="priority" value="Urgent" required aria-required="true" /> Urgent — blocks enrollment, housing safety, or aid this week</label>
            </fieldset>
          </div>
          <p class="page-actions">
            <button class="btn" type="submit">Submit request</button>
          </p>
        </form>
      </div>

      <div class="confirmation" id="confirmation" hidden>
        <p class="eyebrow">Request received</p>
        <h2 id="confirm-heading" tabindex="-1">We have your ticket.</h2>
        <p>Quote this number if you write or call. It is the fastest way to ask about this request.</p>
        <p class="ticket-number" id="ticket-number"></p>
        <h3>What happens next</h3>
        <ol class="next-steps">
          <li>A coordinator reads new requests within one business day. Urgent requests are first.</li>
          <li>The reply goes to <strong id="confirm-email"></strong>.</li>
          <li>Open My requests to see this ticket number again.</li>
          <li>The Help Center desk is <a href={site.helpHref}>{site.helpPhone}</a>, weekdays 9 a.m. to 4 p.m.</li>
        </ol>
        <p class="page-actions">
          <a class="btn" href={u('/support/requests/')}>View my requests</a>
          <a href={u('/support/#request')} id="another-request">Submit another request</a>
        </p>
      </div>
    </section>
  </div>
  <script>
    import '../../scripts/support.ts';
  </script>
</Base>
